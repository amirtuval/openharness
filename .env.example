# Copy to `.env` and fill in what you need: `docker compose up` reads it automatically.
#
# Two secrets are required by the default configuration — the server refuses to boot without
# them — and everything else has a working default. A variable set to nothing counts as unset,
# so leaving a line empty is the same as omitting it. The bundled compose file passes most of
# these through; the sections it does not pass through say so.

# --- secrets (required) ------------------------------------------------------------------------
# BETTER_AUTH_SECRET signs sessions and cookies; OPENHARNESS_SECRETS_KEY (32 bytes, base64)
# wraps the data keys users' model-provider credentials are sealed with. Generate each once:
#
#   openssl rand -base64 32
#
# OPENHARNESS_SECRETS_KEY is required *unless* the key provider below is `gcp-kms`, where the
# master key lives in Cloud KMS instead and this variable is not read.
BETTER_AUTH_SECRET=
OPENHARNESS_SECRETS_KEY=

# --- where the vault's master key lives (staging and production, #150) -------------------------
# Users' model-provider keys are stored sealed: every key gets a fresh data key, and the data
# key is wrapped by a master key. `local` (the default) takes that master key from
# OPENHARNESS_SECRETS_KEY above — the right choice for a laptop, docker compose and CI. Set
# `gcp-kms` on GCP: every wrap and unwrap is a Cloud KMS call (Application Default
# Credentials, i.e. Workload Identity in GKE), the master key never leaves KMS, and
# OPENHARNESS_SECRETS_KEY is not needed. The two modes cannot read each other's rows, and the
# error says so plainly — switching a deployment with stored credentials means re-saving them.
# OPENHARNESS_KEY_PROVIDER=local
# OPENHARNESS_KMS_KEY=projects/openharness/locations/global/keyRings/openharness/cryptoKeys/credentials
#   # the Cloud KMS *key* (no /cryptoKeyVersions/... suffix: rotating the key version needs no
#   # migration, KMS keeps old versions for decryption)
# OPENHARNESS_KEY_CACHE_TTL_MS=300000
#   # how long unwrapped data keys stay cached in memory, so a model request does not always
#   # make a KMS round trip; 0 disables the cache

# The public URL the server answers on. It is what OAuth redirects come back to, what the one
# trusted CSRF origin is, and it must be a localhost URL for the dev login below.
BETTER_AUTH_URL=http://localhost:3000

# --- development login -------------------------------------------------------------------------
# `1` enables email/password with one seeded user (`dev@localhost` / `dev`) for local use,
# e2e and QA. The server refuses to start with it on unless BETTER_AUTH_URL is localhost. It is
# also a way to sign in on its own: with no OAuth provider configured, it is the one that keeps
# the server booting (see the provider section below).
OPENHARNESS_DEV_LOGIN=

# --- signing in with a provider (at least one is required unless the dev login is on) ----------
# Google, GitHub and Microsoft are each enabled when both of their variables are set (set both
# empty — i.e. leave them unset — to hide its button). At least one provider is required unless
# OPENHARNESS_DEV_LOGIN=1 above: the server refuses to boot with no way to sign in. Create an
# OAuth app with the provider and register `<BETTER_AUTH_URL>/api/auth/callback/<provider>` as
# the redirect URI. Microsoft additionally takes the Entra tenant (`common` when unset, which
# is multi-tenant).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Model-provider keys are NOT set here (epic #65, A5): each user brings their own, adds it in
# Settings → Model providers, and the server stores it encrypted. The environment is never read
# for one, not even as a fallback.

# --- trying it without a provider --------------------------------------------------------------
# `mock` swaps the model for a deterministic one that echoes the prompt back: the whole system
# runs, no key and no network. It is the server's test hook — never set it in production.
# OPENHARNESS_TEST_MODEL=mock

# --- Postgres -----------------------------------------------------------------------------------
# The compose file builds DATABASE_URL from these and starts a `postgres` service with them.
# Change them together — the server follows the same values.
POSTGRES_USER=openharness
POSTGRES_PASSWORD=openharness
POSTGRES_DB=openharness

# What the server runs on. The compose file builds its own from the POSTGRES_* vars above; set
# this when you run the server yourself. Unset means an in-memory store: fine for a quick
# trial, nothing survives a restart.
# DATABASE_URL=postgres://openharness:openharness@localhost:5432/openharness

# --- the server itself --------------------------------------------------------------------------
# PORT=3000                       # the published port is 3000:3000 in docker-compose.yml
# OPENHARNESS_MAX_CONCURRENT_SESSIONS=4
# OPENHARNESS_DRAIN_TIMEOUT_MS=5000
# OPENHARNESS_CORS_ORIGINS=       # a comma-separated list; not needed on one origin
# OPENHARNESS_WEB_DIR=            # serve a built web app at `/`; the Docker image sets it

# --- behind a proxy or load balancer (not passed by the bundled compose file) --------------------
# How many proxies in front of this server append to `X-Forwarded-For` (default 0: forwarding
# headers are not trusted, and the client IP is the connection's address). The client IP keys
# Better Auth's rate limiting and is recorded on sessions, so only proxies you run may be
# counted — entries further left in the header are the client's to forge. On GKE behind
# Google's global external HTTPS load balancer, set 1: the load balancer appends
# `<client-ip>, <lb-ip>` and the server reads the second entry from the right.
# OPENHARNESS_TRUSTED_PROXY_HOPS=1

# --- several servers on one database (not passed by the bundled compose file) --------------------
# The default scheduler (`local`) runs every session in this process. `postgres` splits the
# session space into leased partitions: several instances share the load, and when one dies
# another takes its partitions over and finishes its turns. It requires DATABASE_URL.
# SCHEDULER=postgres
# OPENHARNESS_PARTITIONS=64        # how many partitions the session space is divided into
# OPENHARNESS_INSTANCE_ID=         # this server's id in the lease table; host-pid-random by default
# OPENHARNESS_LEASE_TTL_MS=30000   # how long a partition lease lasts before it must be renewed
# OPENHARNESS_HEARTBEAT_MS=10000   # how often leases are renewed and free partitions taken
# OPENHARNESS_SWEEP_MS=60000       # how often owned partitions are re-scanned for missed work

# --- compaction ---------------------------------------------------------------------------------
# A streamed reply is stored twice while it streams: as its chunks, and as the message that
# supersedes them. Replay already skips the superseded chunks, so the retention window only
# keeps the raw chunks around for debugging before the periodic job deletes them. 0 for the
# retention means "as soon as the range is superseded"; an interval of 0 disables the job.
# OPENHARNESS_DELTA_RETENTION_MS=3600000
# OPENHARNESS_COMPACT_INTERVAL_MS=300000
