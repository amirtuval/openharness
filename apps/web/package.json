{
  "name": "@openharness/web",
  "version": "0.0.0",
  "private": true,
  "description": "The openharness web app: Vite + React + TypeScript. It renders a placeholder page; the chat UI lands in the v1 epic.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.html"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:deps": "turbo run build --filter=@openharness/web^...",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@openharness/client": "workspace:*",
    "@openharness/protocol": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@openharness/config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
