{
  "name": "@openharness/session",
  "version": "0.0.0",
  "private": true,
  "description": "The durable, append-only session event log: the SessionStore contract, an in-memory implementation and its conformance suite.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openharness-session-migrate": "./dist/postgres/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "build:deps": "turbo run build --filter=@openharness/session^...",
    "dev": "tsdown --watch",
    "migrate": "node ./dist/postgres/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@openharness/protocol": "workspace:*",
    "kysely": "0.29.6",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@openharness/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "testcontainers": "12.1.0",
    "tsdown": "0.23.0",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
